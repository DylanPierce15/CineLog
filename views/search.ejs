<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Search — CineLog</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <%- include('partials/nav') %>

  <main class="container">
    <h2>Search</h2>

    <form action="/search" method="GET" class="search-form">
      <input
        type="text"
        name="q"
        value="<%= query %>"
        placeholder="Search movies or TV shows…"
        class="search-input"
        required
        autofocus
      />
      <select name="type" class="select-input">
        <option value="movie" <%= type === "movie" ? "selected" : "" %>>Movies</option>
        <option value="tv"    <%= type === "tv"    ? "selected" : "" %>>TV Shows</option>
      </select>
      <button type="submit" class="btn btn-primary">Search</button>
    </form>

    <% if (error) { %><p class="error-msg"><%= error %></p><% } %>

    <% if (query && results.length === 0 && !error) { %>
      <p class="no-results">No results found for "<strong><%= query %></strong>".</p>
    <% } %>

    <div class="results-grid">
      <% results.forEach(item => { %>
        <div class="result-card">
          <% if (item.posterPath) { %>
            <img src="<%= item.posterPath %>" alt="<%= item.title %> poster" class="poster" loading="lazy" />
          <% } else { %>
            <div class="poster poster-placeholder">No Image</div>
          <% } %>
          <div class="card-body">
            <h3 class="card-title"><%= item.title %></h3>
            <p class="card-meta">
              <%= item.year || "—" %> &bull;
              <span class="tmdb-rating">★ <%= item.tmdbRating %></span>
            </p>
            <p class="card-overview"><%= item.overview ? item.overview.slice(0, 120) + (item.overview.length > 120 ? "…" : "") : "" %></p>

            <form action="/watchlist/add" method="POST" class="add-form">
              <input type="hidden" name="tmdbId"     value="<%= item.tmdbId %>" />
              <input type="hidden" name="title"      value="<%= item.title %>" />
              <input type="hidden" name="type"       value="<%= item.type %>" />
              <input type="hidden" name="posterPath" value="<%= item.posterPath || '' %>" />
              <input type="hidden" name="tmdbRating" value="<%= item.tmdbRating %>" />

              <select name="status" class="select-input select-sm">
                <option value="plan to watch">Plan to Watch</option>
                <option value="watching">Watching</option>
                <option value="completed">Completed</option>
                <option value="dropped">Dropped</option>
              </select>

              <input type="number" name="rating" min="1" max="10" placeholder="Your rating (1-10)" class="rating-input" />

              <textarea name="notes" placeholder="Notes (optional)" class="notes-input" rows="2"></textarea>

              <button type="submit" class="btn btn-primary btn-full">+ Add to Watchlist</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </main>
</body>
</html>
