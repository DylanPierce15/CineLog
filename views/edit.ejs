<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Entry — CineLog</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <%- include('partials/nav') %>

  <main class="form-page">
    <div class="form-card">
      <div class="edit-header">
        <% if (entry.posterPath) { %>
          <img src="<%= entry.posterPath %>" alt="<%= entry.title %>" class="edit-poster" />
        <% } %>
        <div>
          <h2><%= entry.title %></h2>
          <span class="badge badge-<%= entry.type %>"><%= entry.type.toUpperCase() %></span>
        </div>
      </div>

      <% if (error) { %><p class="error-msg"><%= error %></p><% } %>

      <form action="/watchlist/edit/<%= entry._id %>" method="POST">
        <label for="status">Status</label>
        <select id="status" name="status" class="select-input">
          <% statuses.forEach(s => { %>
            <option value="<%= s %>" <%= entry.status === s ? "selected" : "" %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
          <% }) %>
        </select>

        <label for="rating">Your Rating (1–10)</label>
        <input type="number" id="rating" name="rating" min="1" max="10"
               value="<%= entry.rating || '' %>" placeholder="Leave blank for no rating" />

        <label for="notes">Notes</label>
        <textarea id="notes" name="notes" rows="4" placeholder="Your thoughts…"><%= entry.notes %></textarea>

        <button type="submit" class="btn btn-primary btn-full">Save Changes</button>
        <a href="/watchlist" class="btn btn-secondary btn-full" style="margin-top:0.5rem;text-align:center;display:block">Cancel</a>
      </form>
    </div>
  </main>
</body>
</html>
