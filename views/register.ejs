<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Register — CineLog</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <%- include('partials/nav') %>

  <main class="form-page">
    <div class="form-card">
      <h2>Create Account</h2>
      <% if (error) { %><p class="error-msg"><%= error %></p><% } %>
      <form action="/register" method="POST">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" required autocomplete="username" />

        <label for="email">Email</label>
        <input type="email" id="email" name="email" required autocomplete="email" />

        <label for="password">Password</label>
        <input type="password" id="password" name="password" required autocomplete="new-password" minlength="6" />

        <label for="confirmPassword">Confirm Password</label>
        <input type="password" id="confirmPassword" name="confirmPassword" required autocomplete="new-password" minlength="6" />

        <button type="submit" class="btn btn-primary btn-full">Register</button>
      </form>
      <p class="form-footer">Already have an account? <a href="/login">Log in</a></p>
    </div>
  </main>
</body>
</html>
